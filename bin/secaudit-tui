    async def on_mount(self) -> None:
        self.register_theme(
            Theme(
                name="omarchy", primary=PAL.accent, secondary=PAL.accent2, accent=PAL.accent,
                warning=PAL.yellow, error=PAL.red, success=PAL.green,
                foreground=PAL.fg, background=PAL.bg, panel=PAL.panel, dark=PAL.dark,
            )
        )
        self.theme = "omarchy"
        if not ENGINE.is_file():
            self.notify(f"secaudit engine not found at {ENGINE}", severity="error", timeout=30)
        self.runs = load_runs()
        if self.runs:
            await self.show_run(self.runs[0])
        else:
            self.show_empty()
        self.apply_layout()
        if self.start_scan_mode:
            self.call_after_refresh(self.start_scan, self.start_scan_mode)

    def on_resize(self) -> None:
        self.apply_layout()
        if self.current:
            self.call_after_refresh(self.refresh_table)

    def apply_layout(self) -> None:
        w = self.size.width
        self.query_one("#body").set_class(w >= WIDE, "wide")
        self.query_one("#body").set_class(w < NARROW, "narrow")
        self.query_one("#overview").set_class(w < NARROW, "narrow")

    def show_empty(self) -> None:
        self.current = None
        self.query_one("#empty").remove_class("hidden")
        for wid in ("#overview", "#body"):
            self.query_one(wid).add_class("hidden")
        self.query_one(TopBar).right = ""
        self.query_one("#btn-full").focus()
        self.refresh_bindings()

    # -- rendering a run -------------------------------------------------

    def previous_of(self, run: Run) -> Run | None:
        paths = [r.path for r in self.runs]
        i = paths.index(run.path) if run.path in paths else -1
        return self.runs[i + 1] if 0 <= i < len(self.runs) - 1 else None

    async def show_run(self, run: Run) -> None:
        if not self.current or self.current.path != run.path:
            self.marked.clear()
        self.current = run
        self.query_one("#empty").add_class("hidden")
        for wid in ("#overview", "#body"):
            self.query_one(wid).remove_class("hidden")

        latest = self.runs and self.runs[0].path == run.path
        when = f"{run.started:%a %-d %b %H:%M} · {run.mode} scan · {ago(run.started)}"
        self.query_one(TopBar).right = when if latest else f"{when}  (older scan, h for history)"

        box = self.query_one("#scorebox")
        for cls in ("good", "mid", "bad"):
            box.remove_class(cls)
        box.add_class(grade_class(run.grade))
        self.query_one("#score", Digits).update(str(run.score))
        self.query_one("#grade", Static).update(self.meter_text(run))

        self.query_one("#stats", Static).update(self.stats_text(run))

        chron = [r for r in reversed(self.runs) if r.started <= run.started] or [run]
        spark = self.query_one("#trend", Sparkline)
        spark.display = len(chron) >= 4
        spark.data = [r.score for r in chron]
        caption = Text()
        if len(chron) < 4:
            # Too few points for a meaningful sparkline: show the recent scores instead
            for i, r in enumerate(chron):
                if i:
                    caption.append(" → ", PAL.muted)
                caption.append(str(r.score), f"bold {grade_color(r.grade)}")
            caption.append("\n")
        caption.append(f"{len(chron)} scan{'s' if len(chron) != 1 else ''} · {chron[0].started:%-d %b} → {run.started:%-d %b}", PAL.muted)
        self.query_one("#trend-caption", Static).update(caption)

        c = run.counts
        self.query_one("#issues", Tab).label = f"Issues {c['fail'] + c['warn']}"
        self.query_one("#accepted", Tab).label = f"Accepted {c['accepted']}"
        self.query_one("#notes", Tab).label = f"Notes {c['info'] + c['skip']}"
        self.query_one("#passed", Tab).label = f"Passed {c['pass']}"
        self.query_one("#all", Tab).label = f"All {len(run.findings)}"

        await self.populate_sections()
        self.refresh_table()
        self.query_one("#table").focus()

    @staticmethod
    def meter_text(run: Run, width: int = 12) -> Text:
        filled = round(width * run.score / 100)
        col = grade_color(run.grade)
        return Text.assemble(
            ("━" * filled, col), ("─" * (width - filled), PAL.muted), ("  "), (run.grade, f"bold {col}")
        )

    @staticmethod
    def tips_text() -> Text:
        t = Text()
        for key, what in (("space", "select"), ("x", "fix selected"), ("*", "select all fixable"),
                          ("a", "accept risk"), ("i", "explain with AI"), ("I", "AI action plan"),
                          ("r", "rescan")):
            t.append(f"{key:>5} ", f"bold {PAL.accent}").append(f"{what}\n", PAL.muted)
        t.rstrip()
        return t

    def stats_text(self, run: Run) -> Text:
        c = run.counts
        t = Text()
        for sev, n in (("fail", c["fail"]), ("warn", c["warn"]), ("pass", c["pass"])):
            icon, label, _ = SEV[sev]
            style = f"bold {sev_color(sev)} on {PAL.panel}" if n else f"{PAL.muted} on {PAL.panel}"
            t.append(f" {icon} {n} {label.lower()} ", style).append("  ")
        if c["accepted"]:
            t.append(f" ≈ {c['accepted']} accepted ", f"{PAL.muted} on {PAL.panel}")
        t.append("\n")

        meta = f"{run.mode.capitalize()} scan of {run.meta.get('host', HOST)}"
        if run.duration is not None:
            meta += f" · took {mmss(run.duration)}"
        meta += f" · {c['info']} notes · {c['skip']} skipped"
        t.append(meta + "\n", PAL.muted)

        prev = self.previous_of(run)
        if prev:
            new, fixed = len(run.issue_keys - prev.issue_keys), len(prev.issue_keys - run.issue_keys)
            t.append("Since previous scan" + ("" if prev.mode == run.mode else f" ({prev.mode})") + ": ", PAL.muted)
            t.append(f"{new} new", f"bold {PAL.red}" if new else PAL.muted).append(" · ", PAL.muted)
            t.append(f"{fixed} resolved", f"bold {PAL.green}" if fixed else PAL.muted)
            delta = run.score - prev.score
            if delta:
                t.append(f" · score {'+' if delta > 0 else ''}{delta}", PAL.green if delta > 0 else PAL.red)
            t.append("\n")
        else:
            t.append("First scan on record\n", PAL.muted)

        if run.mode == "quick":
            t.append("Root-only checks skipped. Press ", f"italic {PAL.muted}")
            t.append("s", f"bold {PAL.accent}").append(" for a full scan.", f"italic {PAL.muted}")
        else:
            unfixed = [f for f in run.findings if f.is_issue and not f.accepted and f.fix and f.n not in run.applied]
            if unfixed:
                t.append(f"{len(unfixed)} issue{'s' if len(unfixed) != 1 else ''} can be fixed automatically. Press ", f"italic {PAL.muted}")
                t.append("*", f"bold {PAL.accent}").append(" then ", f"italic {PAL.muted}")
                t.append("x", f"bold {PAL.accent}").append(" to fix them together.", f"italic {PAL.muted}")
        return t

    async def populate_sections(self) -> None:
        run = self.current
        assert run
        lv = self.query_one("#sections", ListView)
        await lv.clear()
        # sidebar width - border - padding - item padding - scrollbar - icon - count
        width = (26 if self.size.width < NARROW else 32) - 1 - 2 - 2 - 1 - 2 - 3
        items = []
        total = run.counts["fail"] + run.counts["warn"]
        items.append(SectionItem(None, Text.assemble(("◆ ", PAL.accent), (f"{'All sections':<{width}}", "bold"), (f"{total:>3}", PAL.muted))))
        present = {f.section for f in run.findings}
        order = [s for s in self.sections_order if s in present] + sorted(present - set(self.sections_order))
        for sec in order:
            fails = sum(1 for f in run.findings if f.section == sec and f.sev == "fail" and not f.accepted)
            warns = sum(1 for f in run.findings if f.section == sec and f.sev == "warn" and not f.accepted)
            if fails:
                icon, col = "✗", PAL.red
            elif warns:
                icon, col = "!", PAL.yellow
            else:
                icon, col = "✓", PAL.green
            name = clip(sec, width)
            name.pad_right(width - name.cell_len)
            label = Text.assemble((f"{icon} ", f"bold {col}"), name, (f"{fails + warns:>3}" if fails + warns else "   ", col))
            items.append(SectionItem(sec, label))
        await lv.extend(items)
        names = [None] + order
        if self.section not in names:
            self.section = None
        lv.index = names.index(self.section)

    def visible(self) -> list[Finding]:
        if not self.current:
            return []
        q = self.search_text.lower()
        rows = [
            f for f in self.current.findings
            if in_tab(f, self.tab)
            and (self.section is None or f.section == self.section)
            and (not q or q in f"{f.msg}\n{f.section}\n{f.detail}\n{f.fix}\n{f.hint}".lower())
        ]
        return sorted(rows, key=lambda f: (SEV_ORDER.get(f.sev, 9), f.n))

    def refresh_table(self) -> None:
        if not self.current:
            return
        t = self.query_one("#table", DataTable)
        keep = self.selected.n if self.selected else None
        prev_row = t.cursor_row
        t.clear(columns=True)
        avail = max(t.size.width, 60)
        sec_w = 0 if self.section else 22
        ncols = 5 if sec_w else 4
        msg_w = max(24, avail - 1 - 7 - sec_w - 8 - ncols * 2 - 2)
        t.add_column("", key="mark", width=1)
        t.add_column("", key="sev", width=7)
        if sec_w:
            t.add_column("Section", key="sec", width=sec_w)
        t.add_column("Finding", key="msg", width=msg_w)
        t.add_column("Fix", key="fix", width=8)

        applied = self.current.applied
        rows = self.visible()
        for f in rows:
            if f.accepted:
                fix = Text("accepted", style=PAL.muted)
            elif f.n in applied:
                fix = Text("✓ done", style=PAL.green)
            elif f.fix:
                fix = Text("● fix", style=PAL.accent)
            elif f.hint and f.is_issue:
                fix = Text("advice", style=PAL.muted)
            else:
                fix = Text("")
            mark = Text("◉", style=f"bold {PAL.accent}") if f.n in self.marked else Text("")
            badge = sev_badge(f.sev)
            if f.accepted:
                badge.stylize(f"dim {PAL.muted}")
            cells = [mark, badge]
            if sec_w:
                sec_text = clip(f.section, sec_w)
                sec_text.stylize(PAL.muted)
                cells.append(sec_text)
            title = clip(f.title, msg_w)
            if f.accepted:
                title.stylize(PAL.muted)
            cells += [title, fix]
            t.add_row(*cells, key=str(f.n))

        self.update_selbar()
        if not rows:
            self.show_detail(None)
            return
        # Stay on the same finding; if it left this view, stay at the same position
        idx = next((i for i, f in enumerate(rows) if f.n == keep), min(prev_row, len(rows) - 1))
        t.move_cursor(row=idx, animate=False)
        self.show_detail(rows[idx])

    def show_detail(self, f: Finding | None) -> None:
        self.selected = f
        q = self.query_one
        for wid in ("#d-detail-cap", "#d-detail", "#d-fix-cap", "#d-fix", "#d-hint-cap", "#d-hint", "#d-actions"):
            q(wid).display = False
        if f is None:
            if self.tab == "accepted" and not self.search_text:
                msg = Text("No accepted risks", style="bold")
                sub = "Press a on an issue you've decided to live with; it stops counting against your score."
            elif self.tab == "issues" and not self.search_text:
                msg = Text.assemble(("✓ No issues here", f"bold {PAL.green}"))
                sub = "Nothing to fix in this view."
            else:
                msg = Text("No matching findings", style="bold")
                sub = "Try another tab, section, or search."
            q("#d-title", Static).update(msg)
            q("#d-meta", Static).update(sub)
            self.refresh_bindings()
            return

        title = Text.assemble(sev_badge(f.sev), "  ", (f.title, "bold"))
        q("#d-title", Static).update(title)
        meta = Text(f.section, style=PAL.muted)
        if f.accepted:
            when = ACCEPTED.get(f.accept_key, {}).get("at")
            meta.append("  ·  ", PAL.muted).append(
                "accepted risk" + (f" since {datetime.fromtimestamp(when):%-d %b}" if when else "") + ", not scored",
                f"italic {PAL.muted}",
            )
        elif self.current and f.n in self.current.applied:
            meta.append("  ·  ", PAL.muted).append("✓ fix applied, rescan (r) to verify", PAL.green)
        q("#d-meta", Static).update(meta)

        if f.detail:
            q("#d-detail-cap").display = q("#d-detail").display = True
            q("#d-detail", Static).update(Text(f.detail))
        if f.fix:
            q("#d-fix-cap").display = q("#d-fix").display = True
            q("#d-fix", Static).update(Text(f.fix))
        if f.hint:
            q("#d-hint-cap").display = q("#d-hint").display = True
            q("#d-hint", Static).update(Text(f.hint))
        q("#d-actions").display = True
        q("#btn-explain", Button).display = f.sev != "pass"
        if f.fix or f.hint or f.is_issue:
            q("#btn-runfix", Button).display = bool(f.fix) and not f.accepted
            q("#btn-copy", Button).display = bool(f.fix or f.hint)
            q("#btn-copy", Button).label = "Copy fix  c" if f.fix else "Copy advice  c"
            accept = q("#btn-accept", Button)
            accept.display = f.is_issue
            accept.label = "Un-accept  a" if f.accepted else "Accept risk  a"
        if f.sev == "pass" and not f.detail:
            q("#d-meta", Static).update(Text.assemble(meta, ("\nThis check passed.", PAL.muted)))
        self.query_one("#detail", VerticalScroll).scroll_home(animate=False)
        self.refresh_bindings()

    # -- events ----------------------------------------------------------

    @on(DataTable.RowHighlighted, "#table")
    def row_highlighted(self, event: DataTable.RowHighlighted) -> None:
        if self.current and event.row_key.value:
            n = int(event.row_key.value)
            self.show_detail(next((f for f in self.current.findings if f.n == n), None))

    @on(DataTable.RowSelected, "#table")
    def row_selected(self) -> None:
        if self.selected and self.selected.fix:
            self.action_run_fix()
        else:
            self.query_one("#detail").focus()

    @on(ListView.Highlighted, "#sections")
    def section_highlighted(self, event: ListView.Highlighted) -> None:
        if isinstance(event.item, SectionItem) and event.item.section != self.section:
            self.section = event.item.section
            self.refresh_table()

    @on(ListView.Selected, "#sections")
    def section_selected(self) -> None:
        self.query_one("#table").focus()

    @on(Tabs.TabActivated, "#sevtabs")
    def tab_activated(self, event: Tabs.TabActivated) -> None:
        if event.tab.id and event.tab.id != self.tab:
            self.tab = event.tab.id
            self.refresh_table()

    @on(Input.Changed, "#search")
    def search_changed(self, event: Input.Changed) -> None:
        self.search_text = event.value.strip()
        self.refresh_table()

    @on(Input.Submitted, "#search")
    def search_submitted(self) -> None:
        self.query_one("#table").focus()

    @on(Button.Pressed)
    def button(self, event: Button.Pressed) -> None:
        match event.button.id:
            case "btn-full" | "btn-quick" | "btn-deep":
                self.start_scan(event.button.id.removeprefix("btn-"))
            case "btn-runfix":
                self.action_run_fix()
            case "btn-copy":
                self.action_copy()
            case "btn-accept":
                self.run_worker(self.action_accept())
            case "btn-explain":
                self.action_explain()

    # -- actions ---------------------------------------------------------

    def check_action(self, action: str, parameters: tuple) -> bool | None:
        if action in self.MAIN_ONLY and len(self.screen_stack) > 1:
            return False
        if action == "quit" and self.current is None and len(self.screen_stack) == 1:
            return True
        if action == "run_fix":
            return True if self.marked or (self.selected and self.selected.fix and not self.selected.accepted) else None
        if action == "accept":
            return True if self.selected and self.selected.is_issue else None
        if action == "explain":
            return True if self.selected and self.selected.sev != "pass" else None
        if action == "ai_plan":
            return True if self.current else None
        if action in ("toggle_mark", "mark_all"):
            return True if self.current and self.tab != "accepted" else None
        if action == "copy":
            return True if self.selected and (self.selected.fix or self.selected.hint) else None
        if action in ("rescan", "output", "export", "focus_search", "tab", "clear_search"):
            return True if self.current else None
        if action == "history":
            return True if self.runs else None
        return True

    def get_system_commands(self, screen: Screen):
        yield from super().get_system_commands(screen)
        yield SystemCommand("Full scan", "Run every check with sudo", lambda: self.start_scan("full"))
        yield SystemCommand("Quick scan", "User-level checks without sudo", lambda: self.start_scan("quick"))
        yield SystemCommand("Deep scan", "Full scan plus package integrity and whole-disk SUID", lambda: self.start_scan("deep"))
        if self.runs:
            yield SystemCommand("Scan history", "Past scans, trend and changes", self.action_history)
        if self.current:
            yield SystemCommand("Export Markdown report", "Checklist of issues with fixes", self.action_export)
            yield SystemCommand("Full output", "Raw text output of this scan", self.action_output)
            yield SystemCommand("AI action plan", "Claude prioritizes every open issue in this scan", self.action_ai_plan)
        if self.selected and self.selected.sev != "pass":
            yield SystemCommand("Explain with AI", "Claude explains the selected finding and how to fix it", self.action_explain)

    def action_scan(self) -> None:
        self.push_screen(ScanChooser(), lambda mode: mode and self.start_scan(mode))

    def action_rescan(self) -> None:
        self.start_scan(self.current.mode if self.current else "full")

    def start_scan(self, mode: str) -> None:
        if not ENGINE.is_file():
            self.notify(f"secaudit engine not found at {ENGINE}", severity="error")
            return
        if mode != "quick" and not self.ensure_sudo(mode):
            self.notify("No sudo access, scan cancelled. Quick scan works without sudo.", severity="warning")
            return
        self.push_screen(ScanScreen(mode), self.scan_done)

    def ensure_sudo(self, mode: str) -> bool:
        if subprocess.run(["sudo", "-n", "true"], capture_output=True).returncode == 0:
            return True
        with self.suspend():
            print(f"\n  \033[1mSecurity Audit · {mode} scan\033[0m\n")
            print("  This scan reads root-only files: shadow, sudoers, firewall rules, LUKS headers.")
            print("  \033[2mIt never changes anything; sudo is only used to look.\033[0m\n")
            ok = subprocess.run(["sudo", "-v"]).returncode == 0
        self.refresh()
        return ok

    def scan_done(self, path: Path | None) -> None:
        if path is None:
            self.notify("Scan cancelled", severity="warning")
            return
        self.runs = load_runs()
        run = next((r for r in self.runs if r.path == path), None)
        if not run:
            return
        self.section = None
        self.call_later(self.show_run, run)
        c = run.counts
        body = f"Score {run.score} ({run.grade}) · {c['fail']} fail · {c['warn']} warn"
        self.notify(body, title="Scan finished", severity="error" if c["fail"] else "information")
        if shutil.which("notify-send"):
            subprocess.Popen(
                ["notify-send", "-a", "secaudit", "-i", "security-high-symbolic", "Security audit finished", body],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            )

    def fix_targets(self) -> list[Finding]:
        run = self.current
        if not run:
            return []
        if self.marked:
            return [f for f in run.findings if f.n in self.marked]
        f = self.selected
        return [f] if f and f.fix and not f.accepted else []

    def action_run_fix(self) -> None:
        run, targets = self.current, self.fix_targets()
        if not run or not targets:
            self.notify("No automatic fix for this finding. See How to address.", severity="warning")
            return
        many = len(targets) > 1
        code = Text()
        for i, f in enumerate(targets, 1):
            if many:
                code.append(f"{i}. {f.title}\n", f"bold {PAL.fg}")
            code.append(f"$ {f.fix}" + ("\n\n" if many and i < len(targets) else ""), PAL.accent)
        note = "Runs in this terminal. You'll see the output, then return here."
        if any("sudo" in f.fix for f in targets):
            note += " sudo asks for your password once."
        again = [f for f in targets if f.n in run.applied]
        if again:
            note = f"{len(again)} of these {'were' if many else 'was'} already applied in this scan. " + note
        title = f"Run {len(targets)} fixes?" if many else f"Run this fix?  {targets[0].title}"

        def go(ok: bool | None) -> None:
            if not ok:
                return
            results: list[tuple[Finding, int]] = []
            with self.suspend():
                for i, f in enumerate(targets, 1):
                    step = f"[{i}/{len(targets)}] " if many else ""
                    print(f"\n  \033[1m{step}{f.title}\033[0m\n  \033[2m$ {f.fix}\033[0m")
                    rc = subprocess.run(["bash", "-c", f.fix]).returncode
                    print("  \033[32m✓ done\033[0m" if rc == 0 else f"  \033[31m✗ exit status {rc}\033[0m")
                    results.append((f, rc))
                ok_n = sum(1 for _, rc in results if rc == 0)
                print(f"\n  {ok_n} of {len(results)} succeeded.")
                try:
                    input("  Press Enter to return to Security Audit… ")
                except EOFError:
                    pass
            for f, rc in results:
                if rc == 0:
                    run.mark_applied(f.n)
                    self.marked.discard(f.n)
            failed = [f for f, rc in results if rc != 0]
            if failed:
                self.notify(f"{len(failed)} fix{'es' if len(failed) != 1 else ''} failed; they stay selected.", severity="error")
            else:
                self.notify("Press r to rescan and confirm the issues are gone.", title=f"{len(results)} fix{'es' if many else ''} applied")
            self.refresh_table()
            self.query_one("#stats", Static).update(self.stats_text(run))

        self.push_screen(ConfirmScreen(title, code, note, ok=f"Run {len(targets)}" if many else "Run"), go)

    def action_toggle_mark(self) -> None:
        f = self.selected
        if not f:
            return
        if not f.fix or f.accepted:
            self.notify("Only findings with an automatic fix can be selected.", severity="warning", timeout=3)
            return
        self.marked ^= {f.n}
        self.refresh_table()
        self.query_one("#table", DataTable).action_cursor_down()

    def action_mark_all(self) -> None:
        fixable = {f.n for f in self.visible() if f.fix and not f.accepted and f.n not in (self.current.applied if self.current else set())}
        if not fixable:
            self.notify("Nothing in this view has an automatic fix.", severity="warning", timeout=3)
            return
        if fixable <= self.marked:
            self.marked -= fixable
        else:
            self.marked |= fixable
        self.refresh_table()

    def update_selbar(self) -> None:
        bar = self.query_one("#selbar", Static)
        if not self.marked:
            bar.remove_class("show")
            return
        n = len(self.marked)
        bar.update(Text.assemble(
            ("◉ ", f"bold {PAL.accent}"), (f"{n} selected", "bold"), ("   ", ""),
            ("x", f"bold {PAL.accent}"), (f" fix {'all ' if n > 1 else ''}{n}   ", ""),
            ("space", f"bold {PAL.accent}"), (" toggle   ", ""), ("*", f"bold {PAL.accent}"), (" all   ", ""),
            ("esc", f"bold {PAL.accent}"), (" clear", ""),
        ))
        bar.add_class("show")

    async def action_accept(self) -> None:
        f, run = self.selected, self.current
        if not f or not run or not f.is_issue:
            return
        if f.accepted:
            ACCEPTED.pop(f.accept_key, None)
            msg = f"Moved back to Issues: {f.title}"
        else:
            ACCEPTED[f.accept_key] = {"section": f.section, "msg": f.title, "at": int(time.time())}
            self.marked.discard(f.n)
            msg = f"Accepted, no longer scored: {f.title}"
        save_accepted(ACCEPTED)
        for r in self.runs:
            r.recount()
        await self.show_run(run)
        self.notify(msg + "\nPress a again to undo.", timeout=4)

    def action_copy(self) -> None:
        f = self.selected
        if not f:
            return
        text = f.fix or f.hint
        if not text:
            return
        copy_to_clipboard(self, text)
        self.notify("Fix command copied" if f.fix else "Advice copied")

    def with_ai(self, then) -> None:
        """Run `then` once AI is set up, showing the one-time consent/key dialog if needed."""
        if ai_ready():
            then()
            return
        self.push_screen(AISetupScreen(), lambda ok: ok and then())

    def action_explain(self) -> None:
        f, run = self.selected, self.current
        if not f or not run or f.sev == "pass":
            return
        title = Text.assemble(sev_badge(f.sev), "  ", (f.title, "bold"), (f"   {f.section}", PAL.muted))
        prompt = AI_EXPLAIN.format(finding=finding_block(f, run))
        self.with_ai(lambda: self.push_screen(AIScreen(title, prompt, "explain")))

    def action_ai_plan(self) -> None:
        run = self.current
        if not run:
            return
        n = run.counts["fail"] + run.counts["warn"]
        title = Text.assemble(("Action plan  ", "bold"), (f"{n} open issue{'s' if n != 1 else ''} · score {run.score} {run.grade}", PAL.muted))
        self.with_ai(lambda: self.push_screen(AIScreen(title, plan_prompt(run), "action plan")))

    def action_focus_search(self) -> None:
        self.query_one("#search", Input).focus()

    def action_clear_search(self) -> None:
        search = self.query_one("#search", Input)
        if self.marked and not search.has_focus:
            self.marked.clear()
            self.refresh_table()
        elif search.value:
            search.value = ""
        self.query_one("#table").focus()

    def action_tab(self, name: str) -> None:
        self.query_one("#sevtabs", Tabs).active = name

    def action_history(self) -> None:
        def opened(path: Path | None) -> None:
            self.runs = load_runs()
            if path:
                run = next((r for r in self.runs if r.path == path), None)
                if run:
                    self.section = None
                    self.call_later(self.show_run, run)
                    return
            if not self.runs:
                self.show_empty()
            elif self.current and not self.current.path.exists():
                self.call_later(self.show_run, self.runs[0])
            elif self.current:
                self.call_later(self.show_run, self.current)

        self.push_screen(HistoryScreen(), opened)

    def action_output(self) -> None:
        if self.current:
            self.push_screen(LogScreen(self.current))

    def action_export(self) -> None:
        if not self.current:
            return
        out = export_markdown(self.current)
        copy_to_clipboard(self, str(out))
        self.notify(f"{str(out).replace(str(Path.home()), '~')}\nPath copied to clipboard.", title="Report saved", timeout=8)


def main() -> None:
    parser = argparse.ArgumentParser(description="Security Audit terminal app")
    parser.add_argument("--scan", choices=["quick", "full", "deep"], help="start a scan immediately")
    args = parser.parse_args()
    RUNS.mkdir(parents=True, exist_ok=True)
    prune_incomplete()
    AuditApp(start_scan=args.scan).run()


if __name__ == "__main__":
    main()
