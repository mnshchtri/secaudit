    def __init__(self, start_scan: str | None = None):
        super().__init__()
        self.start_scan_mode = start_scan
        self.runs: list[Run] = []
        self.current: Run | None = None
        self.selected: Finding | None = None
        self.tab = "issues"
        self.section: str | None = None
        self.search_text = ""
        self.marked: set[int] = set()
        self.sections_order = engine_sections()

    # -- layout ----------------------------------------------------------

    def compose(self) -> ComposeResult:
