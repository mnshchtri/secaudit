#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.11"
# dependencies = ["textual>=8,<9", "anthropic>=1,<2"]
# ///
"""Security Audit: a terminal app for the secaudit engine.

Runs scans with live progress, lets you browse and search findings, apply
suggested fixes, compare against earlier scans and export reports.
Scan data is shared with secaudit-ui under ~/.local/state/secaudit/runs.

Press i on a finding to have Claude explain it and suggest a fix, or I for
an action plan covering the whole scan (opt-in; uses Claude Code if it is
installed, otherwise an Anthropic API key).

Usage: secaudit-tui [--scan quick|full|deep]
"""

from __future__ import annotations

import argparse
import asyncio
import hashlib
import json
import os
import re
import shutil
import signal
import socket
import subprocess
import time
import tomllib
import uuid
from dataclasses import dataclass
from datetime import datetime
from pathlib import Path

import anthropic
from rich.text import Text
from textual import on, work
from textual.app import App, ComposeResult, SystemCommand
from textual.binding import Binding
from textual.containers import Center, Container, Horizontal, Vertical, VerticalScroll
from textual.reactive import reactive
from textual.screen import ModalScreen, Screen
from textual.theme import Theme
from textual.widget import Widget
from textual.widgets import (
    Button,
    DataTable,
    Digits,
    Footer,
    Input,
    ListItem,
    ListView,
    Log,
    Markdown,
    OptionList,
    ProgressBar,
    RichLog,
    Sparkline,
    Static,
    Tab,
    Tabs,
)
from textual.widgets.option_list import Option

ENGINE = Path(os.environ.get("SECAUDIT_ENGINE") or Path(__file__).resolve().parent / "secaudit")
STATE = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "secaudit"
RUNS = STATE / "runs"
ACCEPTED_FILE = STATE / "accepted.json"
KEEP_RUNS = 30
HOST = socket.gethostname()
USER = os.environ.get("USER", "")
WIDE = 150  # columns at which the detail pane moves beside the table
NARROW = 110  # below this the trend box and sidebar shrink


# ---------------------------------------------------------------------------
# Theme: follow the active Omarchy theme, with neutral fallbacks


@dataclass
class Palette:
    dark: bool = True
    accent: str = "#4b8ef4"
    accent2: str = "#74aeff"
    fg: str = "#e6e6e6"
    bg: str = "#101010"
    panel: str = "#1d1d1d"
    muted: str = "#6b6b6b"
    red: str = "#e06c75"
    yellow: str = "#e5c07b"
    green: str = "#98c379"


def load_palette() -> Palette:
    path = Path.home() / ".local/state/omarchy/current/theme/colors.toml"
    try:
        c = tomllib.loads(path.read_text())
    except (OSError, tomllib.TOMLDecodeError):
        return Palette()
    p = Palette()
    return Palette(
        dark=c.get("mode", "dark") != "light",
        accent=c.get("accent", p.accent),
        accent2=c.get("bright_magenta", c.get("accent", p.accent2)),
        fg=c.get("foreground", p.fg),
        bg=c.get("background", p.bg),
        panel=c.get("lighter_bg", p.panel),
        muted=c.get("muted", p.muted),
        # Bright variants read better as status colors on dark themes
        red=c.get("bright_red" if c.get("mode") != "light" else "red", p.red),
        yellow=c.get("bright_yellow" if c.get("mode") != "light" else "yellow", p.yellow),
        green=c.get("green", p.green),
    )


PAL = load_palette()

SEV = {
    "fail": ("✗", "FAIL", "red"),
    "warn": ("!", "WARN", "yellow"),
    "info": ("i", "NOTE", "accent"),
    "skip": ("–", "SKIP", "muted"),
    "pass": ("✓", "PASS", "green"),
}
SEV_ORDER = {"fail": 0, "warn": 1, "info": 2, "skip": 3, "pass": 4}


def in_tab(f: "Finding", tab: str) -> bool:
    if tab == "issues":
        return f.sev in ("fail", "warn") and not f.accepted
    if tab == "accepted":
        return f.accepted
    if tab == "notes":
        return f.sev in ("info", "skip")
    if tab == "passed":
        return f.sev == "pass"
    return True


def sev_color(sev: str) -> str:
    return getattr(PAL, SEV.get(sev, SEV["info"])[2])


def sev_badge(sev: str) -> Text:
    icon, label, _ = SEV.get(sev, SEV["info"])
    return Text(f"{icon} {label}", style=f"bold {sev_color(sev)}")


# ---------------------------------------------------------------------------
# Accepted risks: issues you have decided to live with. Keyed by section and
# message with numbers masked, so "2 line(s)" and "3 line(s)" match the same
# finding across scans.


def accept_key(section: str, msg: str) -> str:
    return f"{section}|{re.sub(r'[0-9]+', '#', msg.strip().rstrip(':'))}"


def load_accepted() -> dict[str, dict]:
    try:
        data = json.loads(ACCEPTED_FILE.read_text())
        return data if isinstance(data, dict) else {}
    except (OSError, json.JSONDecodeError):
        return {}


def save_accepted(data: dict[str, dict]) -> None:
    ACCEPTED_FILE.parent.mkdir(parents=True, exist_ok=True)
    ACCEPTED_FILE.write_text(json.dumps(data, indent=2))


ACCEPTED = load_accepted()


# ---------------------------------------------------------------------------
# Run data. Each run is a directory with findings.jsonl, meta.json,
# output.txt and optionally applied (line numbers of fixes applied).


@dataclass
class Finding:
    n: int  # 1-based line in findings.jsonl; stable id within a run
    sev: str
    section: str
    msg: str
    detail: str
    fix: str
    hint: str
    accepted: bool = False

    @property
    def is_issue(self) -> bool:
        return self.sev in ("fail", "warn")

    @property
    def accept_key(self) -> str:
        return accept_key(self.section, self.msg)

    @property
    def title(self) -> str:
        return self.msg.rstrip().rstrip(":")

    @property
    def key(self) -> tuple[str, str, str]:
        return (self.sev, self.section, self.msg)


class Run:
    def __init__(self, path: Path):
        self.path = path
        try:
            self.meta = json.loads((path / "meta.json").read_text())
        except (OSError, json.JSONDecodeError):
            self.meta = {}
        self.findings: list[Finding] = []
        for i, line in enumerate((path / "findings.jsonl").read_text().splitlines(), 1):
            if not line.strip():
                continue
            d = json.loads(line)
            self.findings.append(
                Finding(i, d.get("sev", "info"), d.get("section", ""), d.get("msg", ""),
                        d.get("detail", ""), d.get("fix", ""), d.get("hint", ""))
            )
        self.recount()

    def recount(self) -> None:
        """Apply accepted risks; accepted issues no longer count as fail/warn."""
        self.counts = {s: 0 for s in SEV} | {"accepted": 0}
        for f in self.findings:
            f.accepted = f.is_issue and f.accept_key in ACCEPTED
            self.counts["accepted" if f.accepted else f.sev] += 1

    @property
    def complete(self) -> bool:
        return "finished" in self.meta

    @property
    def mode(self) -> str:
        return self.meta.get("mode", "?")

    @property
    def started(self) -> datetime:
        return datetime.fromtimestamp(self.meta.get("started") or self.path.stat().st_mtime)

    @property
    def duration(self) -> int | None:
        s, f = self.meta.get("started"), self.meta.get("finished")
        return f - s if s and f else None

    @property
    def score(self) -> int:
        return max(0, 100 - 10 * self.counts["fail"] - 2 * self.counts["warn"])

    @property
    def grade(self) -> str:
        s = self.score
        return "A" if s >= 90 else "B" if s >= 80 else "C" if s >= 70 else "D" if s >= 60 else "F"

    @property
    def issue_keys(self) -> set[tuple[str, str, str]]:
        return {f.key for f in self.findings if f.is_issue and not f.accepted}

    @property
    def applied(self) -> set[int]:
        try:
            return {int(x) for x in (self.path / "applied").read_text().split()}
        except (OSError, ValueError):
            return set()

    def mark_applied(self, n: int) -> None:
        with open(self.path / "applied", "a") as fh:
            fh.write(f"{n}\n")


def load_runs() -> list[Run]:
    runs = []
    if RUNS.is_dir():
        for d in sorted(RUNS.iterdir(), reverse=True):
            if (d / "findings.jsonl").is_file() and (d / "findings.jsonl").stat().st_size:
                try:
                    run = Run(d)
                except (OSError, json.JSONDecodeError):
                    continue
                if run.complete:
                    runs.append(run)
    return runs


def prune_incomplete(min_age: int = 600) -> None:
    """Remove leftovers of scans that never finished (killed terminal, crash)."""
    if not RUNS.is_dir():
        return
    for d in RUNS.iterdir():
        try:
            meta = json.loads((d / "meta.json").read_text())
        except (OSError, json.JSONDecodeError):
            meta = {}
        if "finished" not in meta and time.time() - d.stat().st_mtime > min_age:
            shutil.rmtree(d, ignore_errors=True)


def grade_class(grade: str) -> str:
    return {"A": "good", "B": "good", "C": "mid", "D": "mid"}.get(grade, "bad")


def grade_color(grade: str) -> str:
    return {"good": PAL.green, "mid": PAL.yellow, "bad": PAL.red}[grade_class(grade)]


def ago(dt: datetime) -> str:
    d = int(time.time() - dt.timestamp())
    if d < 60:
        return "just now"
    if d < 3600:
        return f"{d // 60}m ago"
    if d < 86400:
        return f"{d // 3600}h ago"
    return f"{d // 86400}d ago"


def mmss(sec: int) -> str:
    return f"{sec // 60}:{sec % 60:02d}"


def engine_sections() -> list[str]:
    try:
        src = ENGINE.read_text()
    except OSError:
        return []
    return [s for s in re.findall(r'^section "([^"]+)"', src, re.M) if s != "Summary"]


def clip(text: str, width: int) -> Text:
    t = Text(text.replace("\n", " "))
    t.truncate(max(width, 1), overflow="ellipsis")
    return t


def copy_to_clipboard(app: App, text: str) -> None:
    if shutil.which("wl-copy"):
        subprocess.run(["wl-copy"], input=text.encode(), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    else:
        app.copy_to_clipboard(text)  # OSC 52 fallback


def export_markdown(run: Run) -> Path:
    issues = [f for f in run.findings if f.is_issue and not f.accepted]
    sections: list[str] = []
    for f in issues:
        if f.section not in sections:
            sections.append(f.section)
    c = run.counts
    lines = [
        f"# Security audit: {run.meta.get('host', HOST)}",
        "",
        f"{run.started:%Y-%m-%d %H:%M} · {run.mode} scan · kernel {run.meta.get('kernel', '?')} · "
        f"score **{run.score} ({run.grade})** · {c['fail']} fail · {c['warn']} warn",
        "",
    ]
    for sec in sections:
        lines += [f"## {sec}", ""]
        for f in sorted((f for f in issues if f.section == sec), key=lambda f: SEV_ORDER[f.sev]):
            lines.append(f"- [ ] **{f.sev.upper()}** {f.title}")
            if f.detail:
                lines += ["", "  ```", *(f"  {l}" for l in f.detail.splitlines()), "  ```"]
            if f.fix:
                lines += ["", f"  Fix: `{f.fix}`"]
            if f.hint:
                lines += ["", f"  {f.hint}"]
            lines.append("")
    out = run.path / "report.md"
    out.write_text("\n".join(lines))
    return out


# ---------------------------------------------------------------------------
# Shared widgets


class TopBar(Widget):
    """One-line title bar: app name and host on the left, context on the right."""

    DEFAULT_CSS = "TopBar { height: 1; background: $panel; }"
    right: reactive[str] = reactive("")

    def render(self) -> Text:
        left = Text.assemble(
            (" ◆ ", f"bold {PAL.accent}"), ("Security Audit", "bold"), (f"   {HOST} · {USER}", PAL.muted)
        )
        r = Text(self.right, style=PAL.muted)
        pad = max(1, self.size.width - left.cell_len - r.cell_len - 1)
        return Text.assemble(left, " " * pad, r, " ")


class SectionItem(ListItem):
    def __init__(self, section: str | None, label: Text):
        super().__init__(Static(label))
        self.section = section


class ConfirmScreen(ModalScreen[bool]):
    BINDINGS = [
        Binding("y", "answer(True)", "Yes"),
        Binding("n,escape", "answer(False)", "No"),
    ]

    def __init__(self, title: str, code: str | Text | None = None, note: str = "", ok: str = "Run", danger: bool = False):
        super().__init__()
        self.title_text, self.code, self.note, self.ok, self.danger = title, code, note, ok, danger

    def compose(self) -> ComposeResult:
        with Vertical(id="dialog"):
            yield Static(self.title_text, classes="dialog-title")
            if self.code:
                with VerticalScroll(id="dialog-code"):
                    yield Static(self.code if isinstance(self.code, Text) else Text(self.code), classes="code")
            if self.note:
                yield Static(self.note, classes="dialog-note")
            with Horizontal(id="dialog-buttons"):
                yield Button("Cancel  n", id="no")
                yield Button(f"{self.ok}  y", id="yes", variant="error" if self.danger else "primary")

    def on_mount(self) -> None:
        self.query_one("#no", Button).focus()

    @on(Button.Pressed)
    def pressed(self, event: Button.Pressed) -> None:
        self.dismiss(event.button.id == "yes")

    def action_answer(self, value: bool) -> None:
        self.dismiss(value)


class ScanChooser(ModalScreen[str | None]):
    BINDINGS = [
        Binding("escape", "dismiss(None)", "Cancel"),
        Binding("f", "dismiss('full')", "Full", show=False),
        Binding("q", "dismiss('quick')", "Quick", show=False),
        Binding("d", "dismiss('deep')", "Deep", show=False),
    ]

    MODES = [
        ("full", "Full scan", "f", "sudo · every check · about 20 seconds"),
        ("quick", "Quick scan", "q", "no sudo · skips root-only checks · about 10 seconds"),
        ("deep", "Deep scan", "d", "sudo · adds package integrity and whole-disk SUID · several minutes"),
    ]

    def compose(self) -> ComposeResult:
        with Vertical(id="dialog"):
            yield Static("Start a scan", classes="dialog-title")
            options = []
            for mode, name, key, desc in self.MODES:
                prompt = Text.assemble((name, "bold"), (f"  {key}", PAL.accent), "\n", (desc, PAL.muted))
                options.append(Option(prompt, id=mode))
            yield OptionList(*options, id="chooser-list")
            yield Static("All scans are read-only. sudo is only used to read root-owned files.", classes="dialog-note")

    @on(OptionList.OptionSelected)
    def chosen(self, event: OptionList.OptionSelected) -> None:
        self.dismiss(event.option.id)


# ---------------------------------------------------------------------------
# Scan screen


class ScanScreen(Screen[Path | None]):
    BINDINGS = [Binding("escape", "cancel", "Cancel scan")]
    FRAMES = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"

    def __init__(self, mode: str):
        super().__init__()
        self.mode = mode
        self.sections = engine_sections()
        self.state = {s: {"status": "pending", "warn": 0, "fail": 0} for s in self.sections}
        self.current: str | None = None
        self.proc: asyncio.subprocess.Process | None = None
        self.cancelled = False
        self.failed = False
        self.started = time.time()
        self.frame = 0
        self.dir: Path | None = None

    def compose(self) -> ComposeResult:
        yield TopBar()
        with Center():
            with Vertical(id="scanbox"):
                yield Static(id="scan-title")
                yield ProgressBar(total=max(len(self.sections), 1), show_eta=False, id="scan-progress")
                yield Static(id="scan-elapsed")
                with Vertical(id="checklist"):
                    for i, _ in enumerate(self.sections):
                        yield Static(id=f"sec-{i}", classes="check")
                yield Static("LIVE FINDINGS", classes="caption")
                yield RichLog(id="scan-log", markup=False, wrap=True, max_lines=300)
        yield Footer()

    def on_mount(self) -> None:
        who = USER if self.mode == "quick" else "root"
        self.query_one(TopBar).right = f"{self.mode} scan · as {who}"
        self.query_one("#scan-title", Static).update(Text(f"Scanning {HOST}…", style="bold"))
        self.render_rows()
        self.set_interval(0.1, self.tick)
        self.run_engine()

    def tick(self) -> None:
        if self.proc is None or self.proc.returncode is not None:
            return
        self.frame += 1
        self.query_one("#scan-elapsed", Static).update(
            Text(f"{mmss(int(time.time() - self.started))} elapsed · press escape to cancel", style=PAL.muted)
        )
        if self.current in self.state:
            self.render_row(self.sections.index(self.current))

    def render_rows(self) -> None:
        for i in range(len(self.sections)):
            self.render_row(i)

    def render_row(self, i: int) -> None:
        name = self.sections[i]
        st = self.state[name]
        if st["status"] == "done":
            if st["fail"]:
                icon = Text("✗", style=f"bold {PAL.red}")
            elif st["warn"]:
                icon = Text("!", style=f"bold {PAL.yellow}")
            else:
                icon = Text("✓", style=f"bold {PAL.green}")
            counts = Text()
            if st["fail"]:
                counts.append(f"{st['fail']} fail  ", style=PAL.red)
            if st["warn"]:
                counts.append(f"{st['warn']} warn", style=PAL.yellow)
            row = Text.assemble(" ", icon, "  ", (f"{name:<34}", ""), counts)
        elif st["status"] == "running":
            spin = self.FRAMES[self.frame % len(self.FRAMES)]
            row = Text.assemble(" ", (spin, f"bold {PAL.accent}"), "  ", (f"{name:<34}", "bold"), ("checking…", f"italic {PAL.muted}"))
        else:
            row = Text.assemble(" ", ("·", PAL.muted), "  ", (name, PAL.muted))
        self.query_one(f"#sec-{i}", Static).update(row)

    def advance(self, new_section: str | None) -> None:
        if self.current in self.state:
            self.state[self.current]["status"] = "done"
            self.render_row(self.sections.index(self.current))
        self.current = new_section
        if new_section in self.state:
            self.state[new_section]["status"] = "running"
            self.render_row(self.sections.index(new_section))
        done = sum(1 for s in self.state.values() if s["status"] == "done")
        self.query_one(ProgressBar).update(progress=done)

    def parse(self, line: str) -> None:
        if m := re.match(r"^== (.+) ==$", line):
            self.advance(None if m.group(1) == "Summary" else m.group(1))
            return
        m = re.match(r"^\s+\[(WARN|FAIL)\] (.*)", line)
        if m and self.current in self.state:
            sev = m.group(1).lower()
            self.state[self.current][sev] += 1
            self.query_one(RichLog).write(
                Text.assemble(sev_badge(sev), "  ", (f"{self.current}: ", PAL.muted), m.group(2).rstrip(":"))
            )

    @work(exclusive=True)
    async def run_engine(self) -> None:
        self.dir = RUNS / datetime.now().strftime("%Y%m%d-%H%M%S")
        self.dir.mkdir(parents=True, exist_ok=True)
        meta = {"mode": self.mode, "started": int(self.started), "host": HOST, "user": USER, "kernel": os.uname().release}
        (self.dir / "meta.json").write_text(json.dumps(meta))

        # Name the user explicitly so the scan checks this user's home even under sudo
        cmd = [str(ENGINE), "--json", str(self.dir / "findings.jsonl"), "--user", USER]
        if self.mode == "deep":
            cmd.append("--deep")
        uses_sudo = self.mode != "quick"
        if uses_sudo:
            cmd = ["sudo", "-n", *cmd]  # credentials were cached before this screen opened

        with open(self.dir / "output.txt", "w") as out:
            try:
                self.proc = await asyncio.create_subprocess_exec(
                    *cmd, stdin=asyncio.subprocess.DEVNULL, stdout=asyncio.subprocess.PIPE,
                    # sudo caches the password per terminal session, so a sudo scan must
                    # stay in ours; a quick scan gets its own session so cancel can stop its tree
                    stderr=asyncio.subprocess.STDOUT, start_new_session=not uses_sudo,
                )
            except OSError as e:
                return self.fail(str(e))
            assert self.proc.stdout
            async for raw in self.proc.stdout:
                line = raw.decode(errors="replace").rstrip("\n")
                out.write(line + "\n")
                self.parse(line)
            await self.proc.wait()

        if self.cancelled:
            shutil.rmtree(self.dir, ignore_errors=True)
            return
        findings = self.dir / "findings.jsonl"
        if not findings.is_file() or not findings.stat().st_size:
            tail = (self.dir / "output.txt").read_text().strip().splitlines()[-3:]
            shutil.rmtree(self.dir, ignore_errors=True)
            reason = "\n".join(tail) or f"exit status {self.proc.returncode}"
            if "password is required" in reason:
                reason += ("\nsudo did not keep your password for this terminal. Press escape and start "
                           "the scan again; if it keeps happening, run 'sudo -v' in this terminal first.")
            return self.fail(reason)

        meta["finished"] = int(time.time())
        (self.dir / "meta.json").write_text(json.dumps(meta))
        for old in [r.path for r in load_runs()][KEEP_RUNS:]:
            shutil.rmtree(old, ignore_errors=True)

        self.advance(None)
        self.query_one(ProgressBar).update(progress=len(self.sections))
        self.query_one("#scan-elapsed", Static).update(
            Text(f"Finished in {mmss(int(time.time() - self.started))}", style=PAL.green)
        )
        await asyncio.sleep(0.6)
        self.dismiss(self.dir)

    def fail(self, reason: str) -> None:
        self.failed = True
        self.query_one("#scan-title", Static).update(Text("Scan failed", style=f"bold {PAL.red}"))
        self.query_one("#scan-elapsed", Static).update(Text("press escape to go back", style=PAL.muted))
        self.query_one(RichLog).write(Text(reason, style=PAL.red))

    def stop_engine(self) -> None:
        if self.proc and self.proc.returncode is None:
            self.cancelled = True
            try:
                if self.mode == "quick":
                    os.killpg(self.proc.pid, signal.SIGTERM)  # own session: stop the whole tree
                else:
                    self.proc.terminate()  # sudo relays the signal to the root-owned engine
            except (ProcessLookupError, PermissionError):
                self.proc.terminate()
        if self.cancelled and self.dir:
            # The worker dies with this screen, so clean up here; wait a moment for
            # the engine's last write to land before removing the directory
            d = self.dir
            self.app.set_timer(1.5, lambda: shutil.rmtree(d, ignore_errors=True))

    def action_cancel(self) -> None:
        self.stop_engine()
        self.dismiss(None)

    def on_unmount(self) -> None:
        # Quitting the app mid-scan must not leave the engine running
        self.stop_engine()


# ---------------------------------------------------------------------------
# History screen


class HistoryScreen(Screen[Path | None]):
    BINDINGS = [
        Binding("escape", "back", "Back"),
        Binding("enter", "open", "Open scan"),
        Binding("delete,d", "delete", "Delete scan"),
    ]

    def compose(self) -> ComposeResult:
        yield TopBar()
        with Horizontal(id="hist-top"):
            with Vertical(id="hist-trend"):
                yield Static("SCORE TREND · oldest → newest", classes="caption")
                yield Sparkline([0], id="hist-spark", min_color=PAL.red, max_color=PAL.green)
            yield Static(id="hist-summary")
        yield DataTable(id="hist-table", cursor_type="row")
        yield Static(id="hist-diff")
        yield Footer()

    def on_mount(self) -> None:
        self.query_one(TopBar).right = "history"
        self.populate()
        self.query_one("#hist-table").focus()

    def populate(self) -> None:
        self.runs = load_runs()
        scores = [r.score for r in reversed(self.runs)]
        self.query_one(Sparkline).data = scores or [0]
        summary = Text()
        if self.runs:
            best = max(self.runs, key=lambda r: r.score)
            summary.append("Latest  ", PAL.muted).append(f"{self.runs[0].score} {self.runs[0].grade}\n", f"bold {grade_color(self.runs[0].grade)}")
            summary.append("Best    ", PAL.muted).append(f"{best.score} {best.grade}", f"bold {grade_color(best.grade)}")
            summary.append(f"  {best.started:%-d %b}\n", PAL.muted)
            summary.append("Scans   ", PAL.muted).append(f"{len(self.runs)} kept (max {KEEP_RUNS})")
        self.query_one("#hist-summary", Static).update(summary)

        t = self.query_one(DataTable)
        t.clear(columns=True)
        for label, w in (("When", 18), ("", 9), ("Mode", 6), ("Score", 7), ("Fail", 5), ("Warn", 5), ("Change vs previous", 24)):
            t.add_column(label, width=w)
        for i, r in enumerate(self.runs):
            prev = self.runs[i + 1] if i + 1 < len(self.runs) else None
            change = Text("first scan", style=PAL.muted)
            if prev:
                new, fixed = len(r.issue_keys - prev.issue_keys), len(prev.issue_keys - r.issue_keys)
                change = Text()
                change.append(f"+{new} new", PAL.red if new else PAL.muted).append("  ")
                change.append(f"−{fixed} resolved", PAL.green if fixed else PAL.muted)
            t.add_row(
                f"{r.started:%a %-d %b %H:%M}",
                Text(ago(r.started), style=PAL.muted),
                r.mode,
                Text(f"{r.score:>3} {r.grade}", style=f"bold {grade_color(r.grade)}"),
                Text(str(r.counts["fail"]), style=PAL.red if r.counts["fail"] else PAL.muted),
                Text(str(r.counts["warn"]), style=PAL.yellow if r.counts["warn"] else PAL.muted),
                change,
                key=str(r.path),
            )
        if not self.runs:
            self.query_one("#hist-diff", Static).update(Text("No scans yet.", style=PAL.muted))

    @on(DataTable.RowHighlighted)
    def highlighted(self, event: DataTable.RowHighlighted) -> None:
        i = event.cursor_row
        if not (0 <= i < len(self.runs)):
            return
        r = self.runs[i]
        prev = self.runs[i + 1] if i + 1 < len(self.runs) else None
        out = Text()
        if not prev:
            out.append("First scan on record; nothing to compare against.", PAL.muted)
        else:
            new = sorted(r.issue_keys - prev.issue_keys, key=lambda k: SEV_ORDER[k[0]])
            fixed = sorted(prev.issue_keys - r.issue_keys, key=lambda k: SEV_ORDER[k[0]])
            out.append(f"Compared with {prev.started:%a %-d %b %H:%M} ({prev.mode} scan)\n", PAL.muted)
            out.append("New      ", "bold")
            out.append("none\n" if not new else "\n", PAL.muted)
            for sev, sec, msg in new[:6]:
                out.append("  ").append_text(sev_badge(sev)).append(f"  {sec}: ", PAL.muted).append(msg.rstrip(":") + "\n")
            out.append("Resolved ", "bold")
            out.append("none\n" if not fixed else "\n", PAL.muted)
            for sev, sec, msg in fixed[:6]:
                out.append("  ✓ ", PAL.green).append(f"{sec}: ", PAL.muted).append(msg.rstrip(":") + "\n")
            if prev.mode != r.mode:
                out.append("Different scan modes: some differences come from coverage, not changes.", f"italic {PAL.muted}")
        self.query_one("#hist-diff", Static).update(out)

    @on(DataTable.RowSelected)
    def selected(self, event: DataTable.RowSelected) -> None:
        self.dismiss(Path(event.row_key.value))

    def action_open(self) -> None:
        t = self.query_one(DataTable)
        if self.runs:
            self.dismiss(self.runs[t.cursor_row].path)

    def action_back(self) -> None:
        self.dismiss(None)

    def action_delete(self) -> None:
        if not self.runs:
            return
        r = self.runs[self.query_one(DataTable).cursor_row]

        def done(ok: bool | None) -> None:
            if ok:
                shutil.rmtree(r.path, ignore_errors=True)
                self.populate()
                self.notify("Scan deleted")

        self.app.push_screen(
            ConfirmScreen(f"Delete the {r.mode} scan from {r.started:%a %-d %b %H:%M}?", ok="Delete", danger=True), done
        )


class LogScreen(Screen[None]):
    BINDINGS = [Binding("escape,q", "app.pop_screen", "Back")]

    def __init__(self, run: Run):
        super().__init__()
        self.run_ = run

    def compose(self) -> ComposeResult:
        yield TopBar()
        yield Log(id="log", highlight=False)
        yield Footer()

    def on_mount(self) -> None:
        self.query_one(TopBar).right = f"full output · {self.run_.started:%a %-d %b %H:%M}"
        try:
            text = (self.run_.path / "output.txt").read_text()
        except OSError:
            text = "(no output saved for this scan)"
        log = self.query_one(Log)
        log.write_lines(re.sub(r"\x1b\[[0-9;]*m", "", text).splitlines())
        log.scroll_home(animate=False)
        log.focus()


# ---------------------------------------------------------------------------
# AI assistant: Claude explains findings and suggests fixes. Opt-in: nothing
# is sent until you press i and agree once. Usernames, the hostname and the
# home path are replaced before a request leaves the machine.

CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "secaudit"
CONFIG_FILE = CONFIG_DIR / "config.json"
KEY_FILE = CONFIG_DIR / "anthropic-api-key"
AI_CACHE = STATE / "ai-cache"
MODEL_OVERRIDE = os.environ.get("SECAUDIT_AI_MODEL")
AI_MODEL = MODEL_OVERRIDE or "claude-opus-5-5"
CC_CWD = STATE / "claude-code"  # Claude Code files its sessions by working directory
AI_EFFORT = os.environ.get("SECAUDIT_AI_EFFORT", "medium")
HOME = str(Path.home())

AI_SYSTEM = """You are a security engineer helping the owner of a personal Linux workstation understand results from secaudit, a read-only audit tool. The machine runs Arch Linux with the Omarchy desktop (Hyprland on Wayland, systemd, pacman and the AUR, ufw firewall, LUKS disk encryption). The owner is a developer who also works in DevSecOps: be technically precise, but explain the underlying concepts plainly, as you would to a capable engineer who doesn't specialise in this particular area.

Ground what you say in the findings you are given. Usernames, the hostname and the home directory are redacted as <user>, <host> and ~. Don't assume facts about the machine that the findings don't show; when the right action depends on something you can't see, say what to check and how.

When you suggest commands:
- Prefer the smallest change that resolves the issue, and say when a command needs sudo.
- If secaudit's suggested fix is right, build on it. If it is risky, incomplete or wrong, say so directly and explain why.
- Don't suggest switching off a security control just to clear a finding unless you label it clearly as a trade-off.
- Include a direct way to confirm the fix worked.

Write Markdown for a terminal: short paragraphs, ## headings, fenced code blocks for commands, no tables."""

AI_EXPLAIN = """Explain this secaudit finding and how to deal with it.

{finding}

Use these sections:
## What this means
The issue in plain language, including the concept behind it (what the setting, permission, service or file does).
## Why it matters
A realistic way it could be abused on a personal workstation, and how serious it is here compared with a server. If the risk is low, say so plainly.
## How to fix it
Step by step, with commands and what each one does.
## Trade-offs
What could break or change for the owner, if anything.
## Verify
A direct check that the fix worked.

Keep it under about 450 words."""

AI_PLAN = """Here are the open issues from a secaudit scan of this workstation ({mode} scan, kernel {kernel}, score {score}/100).

<open_issues>
{issues}
</open_issues>
<accepted_risks>
{accepted}
</accepted_risks>

Give the owner an action plan:
## Overall picture
Two or three sentences on the security posture in plain terms.
## Do first
The changes that reduce the most risk for the least effort, in order, with the commands to run.
## Worth doing
Lower-priority hardening, briefly.
## Reasonable to accept
Issues that are often fine on a personal dev workstation, and why, so the owner can decide to accept them.
## Investigate
Anything that could indicate compromise or misconfiguration and needs a closer look, with how to check. Say "nothing stands out" if that's the case.

Keep it under about 650 words."""


def redact(text: str) -> str:
    text = re.sub(rf"{re.escape(HOME)}(?=/|$|[^\w.-])", "~", text)
    for value, label in ((USER, "<user>"), (HOST, "<host>")):
        if value:
            text = re.sub(rf"(?<![\w.-]){re.escape(value)}(?![\w-])", label, text)
    return text


def finding_block(f: Finding, run: Run) -> str:
    parts = [
        "<finding>",
        f"severity: {SEV.get(f.sev, SEV['info'])[1]}",
        f"section: {f.section}",
        f"message: {f.title}",
    ]
    if f.detail:
        parts += ["details:", f.detail]
    if f.fix:
        parts.append(f"secaudit suggested fix: {f.fix}")
    if f.hint:
        parts.append(f"secaudit advice: {f.hint}")
    parts.append("</finding>")
    scope = "as the user; root-only checks were skipped" if run.mode == "quick" else "as root"
    parts.append(f"<context>scan: {run.mode} ({scope}); kernel {run.meta.get('kernel', '?')}</context>")
    return redact("\n".join(parts))


def plan_prompt(run: Run) -> str:
    def line(f: Finding) -> str:
        extra = f" | fix: {f.fix}" if f.fix else (f" | advice: {f.hint}" if f.hint else "")
        detail = f" | details: {' / '.join(f.detail.splitlines()[:6])}" if f.detail else ""
        return f"- [{f.sev.upper()}] {f.section}: {f.title}{detail}{extra}"

    issues = [f for f in run.findings if f.is_issue and not f.accepted]
    accepted = [f for f in run.findings if f.accepted]
    return redact(AI_PLAN.format(
        mode=run.mode, kernel=run.meta.get("kernel", "?"), score=run.score,
        issues="\n".join(line(f) for f in sorted(issues, key=lambda f: SEV_ORDER[f.sev])) or "none",
        accepted="\n".join(f"- {f.section}: {f.title}" for f in accepted) or "none",
    ))


def load_config() -> dict:
    try:
        data = json.loads(CONFIG_FILE.read_text())
        return data if isinstance(data, dict) else {}
    except (OSError, json.JSONDecodeError):
        return {}


def save_config(data: dict) -> None:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    CONFIG_FILE.write_text(json.dumps(data, indent=2))


def stored_key() -> str | None:
    try:
        return KEY_FILE.read_text().strip() or None
    except OSError:
        return None


def store_key(key: str) -> None:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    fd = os.open(KEY_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as fh:
        fh.write(key.strip() + "\n")
    os.chmod(KEY_FILE, 0o600)


def env_credentials() -> bool:
    """Credentials the SDK finds on its own: env vars or an `ant auth login` profile."""
    return bool(
        os.environ.get("ANTHROPIC_API_KEY") or os.environ.get("ANTHROPIC_AUTH_TOKEN")
        or (Path.home() / ".config/anthropic").is_dir()
    )


def claude_bin() -> str | None:
    """The Claude Code CLI; launchers often run without the shell's PATH, so check the usual installs too."""
    home = Path.home()
    candidates = [
        os.environ.get("SECAUDIT_CLAUDE_BIN"),
        shutil.which("claude"),
        str(home / ".local/bin/claude"),
        str(home / ".claude/local/claude"),
        *sorted((str(x) for x in (home / ".local/share/mise/installs/claude").glob("*/claude")), reverse=True),
    ]
    for c in candidates:
        if c and os.path.isfile(c) and os.access(c, os.X_OK):
            return c
    return None


def ai_backend() -> str:
    """'claude-code' (your Claude Code sign-in) or 'api' (an Anthropic API key)."""
    if load_config().get("ai_backend") == "api":
        return "api"
    return "claude-code" if claude_bin() else "api"


def ai_ready() -> bool:
    if not load_config().get("ai_consent"):
        return False
    return ai_backend() == "claude-code" or env_credentials() or bool(stored_key())


def ai_client() -> anthropic.AsyncAnthropic:
    if env_credentials():
        return anthropic.AsyncAnthropic()
    return anthropic.AsyncAnthropic(api_key=stored_key())


def cache_path(prompt: str) -> Path:
    digest = hashlib.sha256(f"{AI_MODEL}\0{AI_SYSTEM}\0{prompt}".encode()).hexdigest()[:24]
    return AI_CACHE / f"{digest}.md"


class AISetupScreen(ModalScreen[bool]):
    """One-time consent. Uses Claude Code when it's installed, otherwise asks for an API key."""

    BINDINGS = [Binding("escape", "dismiss(False)", "Cancel")]

    def __init__(self):
        super().__init__()
        self.mode = "claude-code" if claude_bin() else "api"

    def compose(self) -> ComposeResult:
        with Vertical(id="dialog"):
            yield Static("Explain findings with Claude", classes="dialog-title")
            if self.mode == "claude-code":
                yield Static(Text.assemble(
                    "Explanations come from ", ("Claude Code", "bold"), " using your existing sign-in, so no API key "
                    "is needed. It runs with every tool, MCP server and hook turned off, so it can only answer.\n\n",
                    "When you ask, the finding (section, message, details and suggested fix) is sent to Claude. "
                    "Your username, hostname and home path are replaced first, and the scan never collects secret values.\n\n",
                    ("Nothing is sent until you press i or I. Usage counts toward your Claude plan.", PAL.muted),
                ))
            else:
                yield Static(Text.assemble(
                    "When you ask, the finding (section, message, details and suggested fix) is sent to "
                    "Anthropic's API so Claude can explain it. Your username, hostname and home path are "
                    "replaced first, and the scan never collects secret values.\n\n",
                    ("Nothing is sent until you press i or I. ", PAL.muted),
                    (f"Model: {AI_MODEL}. API usage is billed to your Anthropic account.", PAL.muted),
                ))
                if not env_credentials() and not stored_key():
                    yield Static(Text.assemble(
                        "\nPaste an API key from ", ("console.anthropic.com", f"bold {PAL.accent}"),
                        " → API keys. It's saved to ", (str(KEY_FILE).replace(HOME, "~"), PAL.accent),
                        " readable only by you. Setting ANTHROPIC_API_KEY instead also works.",
                    ))
                    yield Input(placeholder="sk-ant-…", password=True, id="ai-key")
            yield Static("", id="ai-setup-error", classes="dialog-note")
            with Horizontal(id="dialog-buttons"):
                yield Button("Cancel", id="no")
                if self.mode == "claude-code":
                    yield Button("Use an API key instead", id="use-api")
                    yield Button("Use Claude Code", id="yes", variant="primary")
                else:
                    if claude_bin():
                        yield Button("Use Claude Code instead", id="use-cc")
                    yield Button("Enable", id="yes", variant="primary")

    def on_mount(self) -> None:
        inputs = self.query("#ai-key")
        (inputs.first() if inputs else self.query_one("#yes")).focus()

    @on(Input.Submitted, "#ai-key")
    def submitted(self) -> None:
        self.enable()

    @on(Button.Pressed)
    async def pressed(self, event: Button.Pressed) -> None:
        match event.button.id:
            case "yes":
                self.enable()
            case "use-api" | "use-cc":
                self.mode = "api" if event.button.id == "use-api" else "claude-code"
                await self.recompose()
                self.on_mount()
            case _:
                self.dismiss(False)

    def enable(self) -> None:
        keys = self.query("#ai-key")
        if self.mode == "api" and keys:
            key = keys.first(Input).value.strip()
            if not key.startswith("sk-ant-"):
                self.query_one("#ai-setup-error", Static).update(
                    Text("That doesn't look like an Anthropic API key (they start with sk-ant-).", style=PAL.red)
                )
                return
            store_key(key)
        save_config(load_config() | {"ai_consent": True, "ai_backend": self.mode})
        self.dismiss(True)


class AIScreen(Screen[None]):
    """Streams Claude's explanation, then takes follow-up questions."""

    BINDINGS = [
        Binding("escape", "back", "Back"),
        Binding("ctrl+r", "regenerate", "Regenerate"),
        Binding("ctrl+o", "copy", "Copy answer"),
    ]

    def __init__(self, title: Text, prompt: str, subject: str):
        super().__init__()
        self.title_text = title
        self.prompt = prompt
        self.subject = subject
        self.messages: list[dict] = []
        self.last_answer = ""
        self.busy = False
        self.backend = ai_backend()
        self.session_id: str | None = None  # Claude Code conversation, created on the first answer
        self.proc: asyncio.subprocess.Process | None = None

    def compose(self) -> ComposeResult:
        yield TopBar()
        with Vertical(id="ai-box"):
            yield Static(self.title_text, id="ai-title")
            yield Static(Text(
                "AI-generated. Review commands before running them; secaudit's own fixes are on the main screen.",
                style=f"italic {PAL.muted}",
            ), id="ai-note")
            yield VerticalScroll(id="ai-scroll")
            yield Static(id="ai-status")
            yield Input(placeholder="Ask a follow-up, e.g. \"what breaks if I do this?\"  (enter to send)", id="ai-input")
        yield Footer()

    def on_mount(self) -> None:
        via = "Claude Code" if self.backend == "claude-code" else AI_MODEL
        self.query_one(TopBar).right = f"AI · {self.subject} · {via}"
        cached = cache_path(self.prompt)
        if cached.is_file():
            self.show_cached(cached.read_text())
        else:
            self.ask(self.prompt, show_question=False)

    def show_cached(self, text: str) -> None:
        self.messages = [{"role": "user", "content": self.prompt}, {"role": "assistant", "content": text}]
        self.last_answer = text
        self.query_one("#ai-scroll").mount(Markdown(text, classes="ai-answer"))
        self.set_status(Text.assemble(("saved answer", PAL.muted), ("  ·  ctrl+r", f"bold {PAL.accent}"),
                                      (" to ask again", PAL.muted)))
        self.query_one("#ai-input").focus()

    def set_status(self, text: Text | str) -> None:
        self.query_one("#ai-status", Static).update(text)

    @on(Input.Submitted, "#ai-input")
    def follow_up(self, event: Input.Submitted) -> None:
        question = event.value.strip()
        if not question or self.busy:
            return
        event.input.value = ""
        self.ask(question, show_question=True)

    @work(exclusive=True, group="ai")
    async def ask(self, question: str, show_question: bool) -> None:
        self.busy = True
        scroll = self.query_one("#ai-scroll", VerticalScroll)
        box = self.query_one("#ai-input", Input)
        box.disabled = True
        if show_question:
            await scroll.mount(Static(Text.assemble(("You  ", f"bold {PAL.accent}"), question), classes="ai-question"))
        self.messages.append({"role": "user", "content": redact(question)})
        answer = Markdown(classes="ai-answer")
        await scroll.mount(answer)
        scroll.scroll_end(animate=False)
        # Created on the first chunk: stopping a MarkdownStream that never ran raises CancelledError
        stream = None
        started = time.time()
        self.set_status(Text("Claude is thinking…", style=f"italic {PAL.muted}"))
        text_parts: list[str] = []

        async def emit(chunk: str) -> None:
            nonlocal stream
            if stream is None:
                stream = Markdown.get_stream(answer)
                self.set_status(Text("Writing…", style=f"italic {PAL.muted}"))
            text_parts.append(chunk)
            await stream.write(chunk)
            if scroll.max_scroll_y - scroll.scroll_y < 4:
                scroll.scroll_end(animate=False)

        if self.backend == "claude-code":
            try:
                note = await self.ask_claude_code(question, emit)
            finally:
                if stream is not None:
                    await stream.stop()
                else:
                    await answer.remove()
                self.busy = False
                box.disabled = False
                box.focus()
            if note is None:
                return
            self.messages.append({"role": "assistant", "content": "".join(text_parts)})
            self.finish_answer("".join(text_parts), Text(f"{time.time() - started:.0f}s · {note}", style=PAL.muted))
            return

        try:
            async with ai_client().beta.messages.stream(
                model=AI_MODEL,
                max_tokens=16000,
                system=AI_SYSTEM,
                messages=self.messages,
                output_config={"effort": AI_EFFORT},
                # On a safety decline, retry server-side on Anthropic's recommended fallback model
                betas=["server-side-fallback-2026-07-01"],
                fallbacks="default",
            ) as s:
                async for chunk in s.text_stream:
                    await emit(chunk)
                final = await s.get_final_message()
        except anthropic.AuthenticationError:
            return self.ai_error("The API key was rejected. Remove it with: rm " + str(KEY_FILE).replace(HOME, "~"),
                                 retry=False)
        except anthropic.PermissionDeniedError:
            return self.ai_error("This API key can't use this model. Set SECAUDIT_AI_MODEL to one it can use.", retry=False)
        except anthropic.NotFoundError:
            return self.ai_error(f"Model {AI_MODEL} wasn't found. Check SECAUDIT_AI_MODEL.", retry=False)
        except anthropic.RateLimitError:
            return self.ai_error("Rate limited by the API. Wait a moment.")
        except anthropic.APIStatusError as e:
            return self.ai_error(f"API error {e.status_code}: {e.message}")
        except anthropic.APIConnectionError:
            return self.ai_error("Couldn't reach the Anthropic API. Check your connection.")
        except anthropic.AnthropicError as e:
            return self.ai_error(str(e), retry=False)
        finally:
            if stream is not None:
                await stream.stop()
            else:
                await answer.remove()  # nothing arrived; don't leave an empty answer box
            self.busy = False
            box.disabled = False
            box.focus()

        if final.stop_reason == "refusal":
            self.messages.pop()
            return self.ai_error("Claude declined to answer this one. Try rephrasing the question.")
        # Keep the full content (thinking and fallback blocks included) so follow-ups continue the same turn history
        self.messages.append({"role": "assistant", "content": final.content})
        u = final.usage
        note = Text(f"{time.time() - started:.0f}s · {u.input_tokens:,} in / {u.output_tokens:,} out tokens", style=PAL.muted)
        if final.stop_reason == "max_tokens":
            note.append("  ·  answer was cut off, ask it to continue", PAL.yellow)
        if final.model != AI_MODEL:
            note.append(f"  ·  answered by {final.model}", PAL.muted)
        self.finish_answer("".join(text_parts), note)

    def finish_answer(self, text: str, note: Text) -> None:
        self.last_answer = text
        if len(self.messages) == 2 and text:
            AI_CACHE.mkdir(parents=True, exist_ok=True)
            cache_path(self.prompt).write_text(text)
        self.set_status(note)

    async def ask_claude_code(self, question: str, emit) -> str | None:
        """Stream one turn from `claude -p`. Returns a status note, or None after showing an error."""
        exe = claude_bin()
        if not exe:
            self.ai_error("Claude Code (the claude command) wasn't found. Set SECAUDIT_CLAUDE_BIN.", retry=False)
            return None
        prompt = redact(question)
        if self.session_id is None and len(self.messages) > 1:
            # The first answer came from the cache, so this conversation has no session yet; give it the context
            prev = "\n\n".join(f"<{m['role']}>\n{m['content']}\n</{m['role']}>" for m in self.messages[:-1])
            prompt = f"Earlier in this conversation:\n{prev}\n\nFollow-up question: {prompt}"
        new_session = self.session_id is None
        session = self.session_id or str(uuid.uuid4())
        args = [
            exe, "-p", "--output-format", "stream-json", "--verbose", "--include-partial-messages",
            # Answer only: no tools, MCP servers, slash commands or hooks
            "--tools", "", "--strict-mcp-config", "--disable-slash-commands",
            "--settings", json.dumps({"disableAllHooks": True}),
            "--system-prompt", AI_SYSTEM, "--effort", AI_EFFORT,
            "--session-id" if new_session else "--resume", session,
        ]
        if MODEL_OVERRIDE:
            args += ["--model", MODEL_OVERRIDE]
        CC_CWD.mkdir(parents=True, exist_ok=True)
        try:
            self.proc = await asyncio.create_subprocess_exec(
                *args, cwd=CC_CWD, stdin=asyncio.subprocess.PIPE, stdout=asyncio.subprocess.PIPE,
                stderr=asyncio.subprocess.PIPE, limit=16 * 1024 * 1024,
            )
        except OSError as e:
            self.ai_error(f"Couldn't start Claude Code: {e}", retry=False)
            return None
        assert self.proc.stdin and self.proc.stdout and self.proc.stderr
        self.proc.stdin.write(prompt.encode())
        await self.proc.stdin.drain()
        self.proc.stdin.close()

        result: dict = {}
        model = ""
        async for raw in self.proc.stdout:
            try:
                ev = json.loads(raw)
            except json.JSONDecodeError:
                continue
            kind = ev.get("type")
            if kind == "stream_event":
                e = ev.get("event", {})
                d = e.get("delta", {})
                if e.get("type") == "content_block_delta" and d.get("type") == "text_delta":
                    await emit(d.get("text", ""))
            elif kind == "system" and ev.get("subtype") == "init":
                model = ev.get("model", "")
            elif kind == "result":
                result = ev
        err = (await self.proc.stderr.read()).decode(errors="replace").strip()
        rc = await self.proc.wait()
        self.proc = None

        if rc != 0 or not result or result.get("is_error"):
            last_err = err.splitlines()[-1] if err else ""
            msg = str(result.get("result") or last_err or f"exit status {rc}")
            if "login" in msg.lower():
                msg = "Claude Code isn't logged in. Run claude in a terminal and sign in, then try again."
            self.ai_error(msg)
            return None
        if new_session:
            self.session_id = session
        out = (result.get("usage") or {}).get("output_tokens")
        note = "Claude Code" + (f" ({model})" if model else "")
        if out:
            note += f" · {out:,} tokens"
        return note

    def ai_error(self, message: str, retry: bool = True) -> None:
        # Drop the unanswered question so a retry or follow-up starts from a valid history
        if self.messages and self.messages[-1]["role"] == "user":
            self.messages.pop()
        self.busy = False
        hint = "  ·  ctrl+r to retry" if retry else ""
        self.set_status(Text.assemble(("✗ ", f"bold {PAL.red}"), (message, PAL.red), (hint, PAL.muted)))

    async def action_regenerate(self) -> None:
        if self.busy:
            return
        cache_path(self.prompt).unlink(missing_ok=True)
        self.messages = []
        self.session_id = None
        await self.query_one("#ai-scroll").remove_children()
        self.ask(self.prompt, show_question=False)

    def action_copy(self) -> None:
        if self.last_answer:
            copy_to_clipboard(self.app, self.last_answer)
            self.notify("Answer copied")

    def action_back(self) -> None:
        if self.proc and self.proc.returncode is None:
            self.proc.terminate()
        self.workers.cancel_group(self, "ai")
        self.dismiss(None)


